# Copia a .env y genera una clave: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_AGE=1800
# DB_PATH= (ruta absoluta opcional; omitir para usar db.sqlite3)
TRUST_PROXY_HTTPS=False
# Datos exclusivamente académicos. Define contraseñas propias (mínimo 10 caracteres).
DEMO_ADMIN_USERNAME=admin_demo
DEMO_ENCARGADO_USERNAME=encargado_demo
DEMO_ADMIN_PASSWORD=
DEMO_ENCARGADO_PASSWORD=
